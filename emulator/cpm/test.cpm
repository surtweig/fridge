struct person
(
    string name;
    uint8 age;
);

static char charTest 'x';

static string stringTest "zuzu";

static <char array 5> textTest ('1'; '2'; '3'; '4'; '5');

const uint8 intArraySize (+ 2, 3);

const uint16 constAnswer 42d;

const string helloConst "Hello, const!";

static <uint8 array intArraySize> MyStaticArray (0; + 1, 1; 2; 3; 4);

static X2AL.Zuzu MyStaticZuzu (a 5; b 10; c 15);

const X2AL.Zuzu constZuzu (a 1; b 2; c 3);

static <string array 2> stringArrayTest ("ab"; "cd");

static person me (name "zuzu"; age 36);

const person nobody (name "none"; age 0);

