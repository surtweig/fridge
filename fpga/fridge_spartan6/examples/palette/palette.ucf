# Digilent Atlys revision C, dedicated HDMI OUT connector.
NET "clk" LOC = "L15" | IOSTANDARD = LVCMOS33;
NET "clk" TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 10 ns HIGH 50%;
NET "reset_button" LOC = "T15" | IOSTANDARD = LVCMOS33;
NET "reset_button" TIG;
# Lock loss asserts reset asynchronously; release is synchronized separately
# in each domain. Only this asynchronous reset path is excluded from timing.
NET "clock_fault" TIG;
NET "led<0>" LOC = "U18" | IOSTANDARD = LVCMOS33;
NET "led<1>" LOC = "M14" | IOSTANDARD = LVCMOS33;
NET "led<2>" LOC = "N14" | IOSTANDARD = LVCMOS33;
NET "led<3>" LOC = "L14" | IOSTANDARD = LVCMOS33;
NET "tmds_clk_p" LOC = "B6" | IOSTANDARD = TMDS_33;
NET "tmds_clk_n" LOC = "A6" | IOSTANDARD = TMDS_33;
NET "tmds_p<0>" LOC = "D8" | IOSTANDARD = TMDS_33;
NET "tmds_n<0>" LOC = "C8" | IOSTANDARD = TMDS_33;
NET "tmds_p<1>" LOC = "C7" | IOSTANDARD = TMDS_33;
NET "tmds_n<1>" LOC = "A7" | IOSTANDARD = TMDS_33;
NET "tmds_p<2>" LOC = "B8" | IOSTANDARD = TMDS_33;
NET "tmds_n<2>" LOC = "A8" | IOSTANDARD = TMDS_33;
# CPU and pixel clocks are asynchronous. Ignore only the first-stage
# control synchronizers and the existing VPRE pending-control captures;
# subsequent synchronizer stages remain covered by their clock periods.
NET "cpu_clk_raw" TNM_NET = "cpu_clk_raw";
NET "pixel_raw" TNM_NET = "pixel_raw";
INST "video/toggle_meta" TNM = "cdc_pixel_controls";
INST "video/mode_meta" TNM = "cdc_pixel_controls";
INST "video/pend_visible" TNM = "cdc_pixel_controls";
INST "video/pend_hoff*" TNM = "cdc_pixel_controls";
INST "video/pend_voff*" TNM = "cdc_pixel_controls";
INST "video/pal_req_meta" TNM = "cdc_pixel_controls";
TIMESPEC "TS_cdc_controls" = FROM "cpu_clk_raw" TO "cdc_pixel_controls" TIG;
INST "video/pal_ack_meta" TNM = "cdc_cpu_ack";
TIMESPEC "TS_cdc_ack" = FROM "pixel_raw" TO "cdc_cpu_ack" TIG;
# Palette RGB/index are bundled data held until acknowledgement. They must
# settle before the synchronized request reaches the receiving write edge
# (at least two 13.468 ns pixel periods). Bound this path to 20 ns instead
# of excluding it with a clock-to-clock TIG.
INST "video/pal_rgb_hold*" TNM = "pal_payload";
INST "video/pal_index_hold*" TNM = "pal_payload";
INST "video/palette*" TNM = "pal_colours";
TIMESPEC "TS_pal_payload" = FROM "pal_payload" TO "pal_colours" 20 ns DATAPATHONLY;
