// Boot a section from the mounted fridgemulib ROM into RAM at 0x0200.
offset 0x0000

// Loading 253 segments ends at 0xFF00, leaving room for the return jump
// and the descending stack at the top of RAM.
alias BOOT_FIRST_OVERSIZE_COUNT 0xFE

// Keep reset, section index and IRQ vectors at their fixed addresses.
JMP boot.start
NOP // FRIDGE_BOOT_SECTION_INDEX_ADDRESS (0x0003), default section 0.

subroutine boot.timer_irq // FRIDGE_IRQ_SYS_TIMER (0x0004)
    EI
endsub
NOP

JMP boot.keyboard_irq // FRIDGE_IRQ_KEYBOARD (0x0007)

entry boot.start
    DI
    LXI SP, 0xFFFF

    // A program that jumps back to reset may have installed its own handlers.
    LXI HL, FRIDGE_IRQ_SYS_TIMER
    MVI M, #EI
    INX HL
    MVI M, #RET
    INX HL
    MVI M, #NOP
    INX HL
    MVI M, #JMP
    LXI DE, boot.keyboard_irq_$ADDR
    INX HL
    MOV M, D
    INX HL
    MOV M, E

    // The last mounted segment is the fallback end for the final TOC record.
    MVI A, 1
    OUT FRIDGE_DEV_ROM_RESET_ID
    IN FRIDGE_DEV_ROM_RESET_ID
    MOV D, A
    IN FRIDGE_DEV_ROM_RESET_ID
    MOV E, A
    ORA D
    JZ boot.invalid

    // Reuse the executable buffer for TOC scratch space before loading data.
    LXI HL, FRIDGE_EXECUTABLE_OFFSET
    CALL rom_read_toc
    LXI HL, FRIDGE_EXECUTABLE_OFFSET
    LDA FRIDGE_BOOT_SECTION_INDEX_ADDRESS
    CALL rom_section_bounds
    JNZ boot.invalid

    MOV A, D
    ORA A
    JNZ boot.invalid
    MOV A, E
    CPI BOOT_FIRST_OVERSIZE_COUNT
    JP boot.invalid
    CALL rom_read_section
    JNZ boot.invalid

    // An executable that falls through its padded section restarts the loader.
    MVI M, #JMP
    INX HL
    MVI M, 0
    INX HL
    MVI M, 0
    XRA A
    STA FRIDGE_BOOT_SECTION_INDEX_ADDRESS
    JMP FRIDGE_EXECUTABLE_OFFSET

entry boot.invalid
    DI
    HLT

subroutine boot.keyboard_handler
    entry boot.keyboard_irq
    PUSH AF
    IN FRIDGE_DEV_KEYBOARD_ID
    POP AF
    EI
endsub

include "rom.falc"
