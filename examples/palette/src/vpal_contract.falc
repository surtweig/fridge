// CPU VPAL ABI test: all byte indices, flags and registers, slow GPU.
offset 0x0000
static TestIndex 0
main start
entry loop
    MVI A, 0xFF
    ADI 1                 // Z/P/C flags = 0x45; MVI/STA/MOV leave flags alone.
    LDA TestIndex
    MVI B, 0x12
    MVI C, 0x34
    MVI D, 0x56
    MVI E, 0x78
    LXI HL, 0x9ABC
    VPAL
    STA 0xF000
    MOV A, B
    STA 0xF001
    MOV A, C
    STA 0xF002
    MOV A, D
    STA 0xF003
    MOV A, E
    STA 0xF004
    MOV A, H
    STA 0xF005
    MOV A, L
    STA 0xF006
    PUSH AF
    POP HL
    MOV A, L
    STA 0xF007
    LDA TestIndex
    INR A
    STA TestIndex
    JNZ loop
    HLT
