@const uint8
alias VEGA_WIDTH FRIDGE_GPU_FRAME_EGA_WIDTH
@const uint8
alias VEGA_HEIGHT FRIDGE_GPU_FRAME_EGA_HEIGHT

@const uint8
alias VEGA_SPRITE_MODE_INVISIBLE 0
@const uint8
alias VEGA_SPRITE_MODE_OPAQUE 1
@const uint8
alias VEGA_SPRITE_MODE_TRANSPARENT_ZERO 2
@const uint8
alias VEGA_SPRITE_MODE_ADDITIVE 3
@const uint8
alias VEGA_SPRITE_MODE_SUBTRACTIVE 4
@const uint8
alias VEGA_SPRITE_MODE_BITWISE_AND 5
@const uint8
alias VEGA_SPRITE_MODE_BITWISE_OR 6
@const uint8
alias VEGA_SPRITE_MODE_BITWISE_XOR 7

@const uint8
alias VEGA_RLE_MODE_OPAQUE 0
@const uint8
alias VEGA_RLE_MODE_TRANSPARENT_ZERO 1
@const uint8
alias VEGA_RLE_MODE_DITHERED 2
@const uint8
alias VEGA_RLE_MODE_INDEX_ADDITIVE 3


@const uint8
alias VEGA_SWAP_MODE_NONE FRIDGE_GPU_VIDEO_SWAP_NONE
@const uint8
alias VEGA_SWAP_MODE_AUTO FRIDGE_GPU_VIDEO_SWAP_AUTO
@const uint8
alias VEGA_SWAP_MODE_MANUAL_00 FRIDGE_GPU_VIDEO_SWAP_MANUAL_00
@const uint8
alias VEGA_SWAP_MODE_MANUAL_01 FRIDGE_GPU_VIDEO_SWAP_MANUAL_01
@const uint8
alias VEGA_SWAP_MODE_MANUAL_10 FRIDGE_GPU_VIDEO_SWAP_MANUAL_10
@const uint8
alias VEGA_SWAP_MODE_MANUAL_11 FRIDGE_GPU_VIDEO_SWAP_MANUAL_11


@const uint16
alias VEGA_VMEM_ALLOC_OFFSET 0x0200 // first 256 bytes are scratch space
@const uint16
alias VEGA_VMEM_CHECKPOINT_STACK_ADDR 0x0100 // page-aligned for byte indexing
@const uint8
alias VEGA_VMEM_MAX_CHECKPOINTS 128
@static uint8
static VEGA_VMEM_CHECKPOINT_COUNTER 0
@static uint16
static VEGA_VMEM_ALLOC_POINTER VEGA_VMEM_ALLOC_OFFSET

@static uint8
static VEGA_SWAP_MODE FRIDGE_GPU_VIDEO_SWAP_AUTO

@static uint8
static VEGA_X_OFFSET 0

@static uint8
static VEGA_Y_OFFSET 0

@inline void()
subroutine vega_begin
    MVI A, FRIDGE_GPU_VIDEO_MODE_EGA
    VMODE
endsub

@inline void()
subroutine vega_present
    LDA VEGA_X_OFFSET
    MOV H, A
    LDA VEGA_Y_OFFSET
    MOV L, A
    LDA VEGA_SWAP_MODE
    VPRE
endsub

@inline void( (uint8 index : A), (uint8 r : B), (uint8 g : C), (uint8 b : D) )
subroutine vega_set_pallette
    VPAL
endsub

// Packed bytes in the active framebuffer, two palette indices per byte.
@inline uint8:A( (uint16 address : HL) )
subroutine vega_frame_read_byte
    VFLA
endsub

@inline void( (uint16 address : HL), (uint8 value : A) )
subroutine vega_frame_write_byte
    VFSA
endsub

// Positions throughout this library pack x in the high byte and y in the low byte.
@inline uint8:A( (uint16 position : HL) )
subroutine vega_frame_read_pixel
    VFLAC
endsub

@inline void( (uint16 position : HL), (uint8 color : A) )
subroutine vega_frame_write_pixel
    // Put the palette index in both nibbles so VFSAC can select by x parity.
    ANI 0x0F
    MOV B, A
    RLC
    RLC
    RLC
    RLC
    ORA B
    VFSAC
endsub

// Copy count bytes from framebuffer offset source to RAM address dest.
// Both ranges must fit. A zero count leaves memory alone.
@void( (uint16 source : HL), (uint16 dest : DE), (uint16 count : BC) )
subroutine vega_frame_download_batch
    entry vega_frame_download_batch.loop
        MOV A, B
        ORA C
        RZ
        VFLA
        STAX DE
        INX HL
        INX DE
        DCX BC
        JMP vega_frame_download_batch.loop
endsub

// Copy 16 bytes from RAM address source to framebuffer offset dest.
// The full range must fit, and callers must not interrupt another call to this routine.
@void( (uint16 source : HL), (uint16 dest : DE) )
subroutine vega_frame_upload_batch_x16
    PUSH DE
    LXI DE, _vega_frame_upload_batch_x16_rack_$ADDR
    CALL _vega_patch_batch_x16
    POP DE
    XCNG
    CALL _vega_frame_upload_batch_x16_rack
endsub

@inline uint8:A( (uint16 address : HL) )
subroutine vega_sprite_read_byte
    VSLA
endsub

@inline void( (uint16 address : HL), (uint8 value : A) )
subroutine vega_sprite_write_byte
    VSSA
endsub

@inline void( (uint16 address : HL), (uint8 high : B), (uint8 low : C) )
subroutine vega_sprite_write_two_nibbles
    MOV A, B
    RAL
    RAL
    RAL
    RAL
    ANI 0xF0
    MOV B, A
    MOV A, C
    ANI 0x0F
    ORA B
    VSSA
endsub


// Copy 16 bytes from RAM address source to sprite-memory offset dest.
// The full range must fit, and callers must not interrupt another call to this routine.
// Returns the next sprite-memory offset in HL and the next RAM address in DE.
@void( (uint16 source : HL), (uint16 dest : DE) )
subroutine vega_sprite_upload_batch_x16
    PUSH DE
    LXI DE, _vega_sprite_upload_batch_x16_rack_$ADDR
    CALL _vega_patch_batch_x16
    POP DE
    XCNG
    CALL _vega_sprite_upload_batch_x16_rack
endsub

// Copy count bytes from RAM address source to sprite-memory offset dest.
// Both ranges must fit. A zero count leaves memory alone.
// Calls that use the shared 16-byte uploader must not interrupt one another.
// Advances HL and DE by count and leaves BC zero.
@void( (uint16 source : HL), (uint16 dest : DE), (uint16 count : BC) )
subroutine vega_sprite_upload_batch
    entry vega_sprite_upload_batch.loop
        MOV A, B
        ORA A
        JNZ vega_sprite_upload_batch.block
        MOV A, C
        CPI 16
        JM vega_sprite_upload_batch.tail

    entry vega_sprite_upload_batch.block
        MOV A, C
        SUI 16
        MOV C, A
        MOV A, B
        SBI 0
        MOV B, A
        PUSH BC
        CALL vega_sprite_upload_batch_x16
        POP BC
        XCNG
        JMP vega_sprite_upload_batch.loop

    entry vega_sprite_upload_batch.tail
        MOV A, C
        ORA A
        RZ
        XCNG
    entry vega_sprite_upload_batch.byte
        LDAX DE
        VSSA
        INX DE
        INX HL
        DCR C
        JNZ vega_sprite_upload_batch.byte
        XCNG
endsub

// Copy count bytes from RAM address source to sprite-memory offset dest.
// Both ranges must fit. A zero count leaves memory alone.
// Advances HL and DE by count and leaves BC zero.
@void( (uint16 source : HL), (uint16 dest : DE), (uint16 count : BC) )
subroutine vega_sprite_upload
    XCNG
    MOV A, C
    ORA A
    JZ vega_sprite_upload.next_chunk

    entry vega_sprite_upload.byte
        LDAX DE
        VSSA
        INX DE
        INX HL
        DCR C
        JNZ vega_sprite_upload.byte

    entry vega_sprite_upload.next_chunk
        MOV A, B
        ORA A
        JZ vega_sprite_upload.done
        DCR B
        // Starting at C = 0 makes the byte loop run for 256 bytes.
        JMP vega_sprite_upload.byte

    entry vega_sprite_upload.done
        XCNG
endsub

// Copy count bytes from sprite-memory offset source to framebuffer offset dest.
// Both ranges must fit. A zero count leaves memory alone.
@void( (uint16 source : HL), (uint16 dest : BC), (uint16 count : DE) )
subroutine vega_sprite_to_frame_batch
    entry vega_sprite_to_frame_batch.loop
        MOV A, D
        ORA E
        RZ
        VS2F
        INX HL
        INX BC
        DCX DE
        JMP vega_sprite_to_frame_batch.loop
endsub

// Define a hidden sprite backed by packed pixels in sprite memory.
@inline void( (uint8 index : A), (uint8 width : B), (uint8 height : C), (uint16 address : HL) )
subroutine vega_sprite_setup
    VSS
endsub

@inline void( (uint8 index : A), (uint8 mode : B), (uint16 position : HL) )
subroutine vega_sprite_draw
    VSD
endsub

// The high nibble of each sprite-memory token is color. The low nibble is run length minus one.
@inline void( (uint8 index : A), (uint8 nominal_length : B), (uint16 address : HL) )
subroutine vega_rle_line_setup
    VRS
endsub

// stride packs signed dx in the high nibble and signed dy in the low nibble.
@inline void( (uint8 index : A), (uint8 visible_length : B), (uint8 stride : C), (uint8 mode : D), (uint8 posx : H), (uint8 posy : L) )
subroutine vega_rle_line_draw
    VRD
endsub

// HL points to 16 source bytes. DE points to eight three-byte store instructions.
subroutine _vega_patch_batch_x16
    INX DE // skip the first opcode
    MVI B, 8
    entry _vega_patch_batch_x16.loop
        LDAX HL
        INX HL
        STAX DE
        INX DE
        LDAX HL
        INX HL
        STAX DE
        INX DE
        INX DE // skip the next opcode
        DCR B
        JNZ _vega_patch_batch_x16.loop
endsub

subroutine _vega_frame_upload_batch_x16_rack
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
    VFSI 0x00, 0x00
endsub

subroutine _vega_sprite_upload_batch_x16_rack
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
    VSSI 0x00, 0x00
endsub

// Save the allocation pointer in the next big-endian checkpoint slot.
// Returns the zero-based slot index in A.
@uint8:A()
subroutine vega_vmem_checkpoint_acquire
    LDA VEGA_VMEM_CHECKPOINT_COUNTER
    CPI VEGA_VMEM_MAX_CHECKPOINTS
    JP _vega_vmem_panic // Fridge CPI sets Sign when A is less than the operand.
    MOV B, A
    ADD A
    LHLD VEGA_VMEM_ALLOC_POINTER
    XCNG
    LXI HL, VEGA_VMEM_CHECKPOINT_STACK_ADDR
    MOV L, A
    MOV A, D
    VSSA
    INX HL
    MOV A, E
    VSSA
    MOV A, B
    INR A
    STA VEGA_VMEM_CHECKPOINT_COUNTER
    MOV A, B
endsub

// Restore the allocation pointer and return the popped slot index in A.
@uint8:A()
subroutine vega_vmem_checkpoint_release
    LDA VEGA_VMEM_CHECKPOINT_COUNTER
    ORA A
    JZ _vega_vmem_panic
    DCR A
    MOV B, A
    ADD A
    LXI HL, VEGA_VMEM_CHECKPOINT_STACK_ADDR
    MOV L, A
    VSLA
    MOV C, A
    INX HL
    VSLA
    MOV L, A
    MOV H, C
    SHLD VEGA_VMEM_ALLOC_POINTER
    MOV A, B
    STA VEGA_VMEM_CHECKPOINT_COUNTER
endsub

// HL takes the size in bytes and returns the original allocation pointer.
// Zero encodes the one-past-end pointer for the emulator's 64 KiB of VMEM.
// A zero-size allocation returns the current pointer without advancing it.
@uint16:HL ( (uint16 size : HL) )
subroutine vega_vmem_alloc
    XCNG
    LHLD VEGA_VMEM_ALLOC_POINTER
    MOV A, D
    ORA E
    RZ
    MOV A, H
    ORA L
    JZ _vega_vmem_panic

    XCNG // DE holds the original pointer.
    MOV A, L
    ADD E
    MOV L, A
    MOV A, H
    ADC D
    MOV H, A
    JNC vega_vmem_alloc.commit
    ORA L // A carry is valid only for an exact fit ending at 0x10000.
    JNZ _vega_vmem_panic

    entry vega_vmem_alloc.commit
        SHLD VEGA_VMEM_ALLOC_POINTER
        XCNG
        RET

    entry _vega_vmem_panic
        DI
        LXI HL, 0x0020 // FRIDGE_FLAG_PANIC_MASK in F.
        PUSH HL
        POP AF
        HLT
endsub
