{
    "name": "Frion",
    "scopeName": "source.cpm",
    "patterns": [
        { "include": "#comments" },
        { "include": "#literals" },
        { "include": "#compound-type" },
        { "include": "#group" },
        { "include": "#words" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cpm",
                    "match": "//.*"
                },
                {
                    "name": "comment.block.cpm",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "string.quoted.double.cpm",
                    "begin": "\"",
                    "end": "\""
                },
                {
                    "name": "string.quoted.single.cpm",
                    "match": "'[^'\\r\\n]'"
                },
                {
                    "name": "constant.numeric.hex.cpm",
                    "match": "(?<![\\w+-])0x(?:[0-9A-Fa-f]{4}|[0-9A-Fa-f]{2})(?!\\w)"
                },
                {
                    "name": "constant.numeric.decimal.cpm",
                    "match": "(?<![\\w+-])[+-]?[0-9]+d?(?!\\w)"
                },
                {
                    "name": "constant.language.cpm",
                    "match": "\\b(?:true|false|null)\\b"
                }
            ]
        },
        "compound-type": {
            "comment": "A type starts immediately after '<'. Parenthesized array sizes can contain comparison operators.",
            "name": "meta.type.cpm",
            "begin": "<(?=<*[A-Za-z_])",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.type.begin.cpm" }
            },
            "end": "(>)|(?=[;)])",
            "endCaptures": {
                "1": { "name": "punctuation.definition.type.end.cpm" }
            },
            "patterns": [
                { "include": "$self" },
                {
                    "name": "storage.modifier.type.cpm",
                    "match": "\\b(?:ptr|array)\\b"
                }
            ]
        },
        "group": {
            "begin": "\\(",
            "beginCaptures": {
                "0": { "name": "punctuation.section.group.begin.cpm" }
            },
            "end": "\\)",
            "endCaptures": {
                "0": { "name": "punctuation.section.group.end.cpm" }
            },
            "patterns": [
                { "include": "$self" }
            ]
        },
        "words": {
            "patterns": [
                {
                    "name": "keyword.control.cpm",
                    "match": "\\b(?:if|else|for|return|break|continue)\\b"
                },
                {
                    "name": "keyword.control.import.cpm",
                    "match": "\\b(?:include|using|imports)\\b"
                },
                {
                    "name": "storage.type.cpm",
                    "match": "\\b(?:namespace|struct|union|void|bool|char|u?int(?:8|16)|string)\\b"
                },
                {
                    "name": "storage.modifier.cpm",
                    "match": "\\b(?:static|const)\\b"
                },
                {
                    "name": "support.function.intrinsic.cpm",
                    "match": "\\b__(?:mvi_[abc]|lxi_hl|callsub)\\b"
                },
                {
                    "name": "support.constant.cpm",
                    "match": "\\bFRIDGE_[A-Z0-9_]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.wordlike.cpm",
                    "match": "\\b(?:cast|convert|at|addr)\\b"
                },
                {
                    "name": "keyword.operator.cpm",
                    "match": "<<(?=\\s)|>>|[=!<>]=|\\+\\+|--|&&|\\|\\||[-+*/%]=|[-+*/%&|^~!=<>]"
                },
                {
                    "name": "punctuation.separator.cpm",
                    "match": "[,.;]"
                }
            ]
        }
    }
}
